{
  "name": "homebridge-telldus-too",
  "version": "1.3.0",
  "description": "Alternative Telldus plugin for Homebridge: https://github.com/nfarina/homebridge",
  "keywords": [
    "automation",
    "homebridge-plugin",
    "random",
    "telldus"
  ],
  "homepage": "http://github.com/kernie66/homebridge-telldus-too#readme",
  "bugs": {
    "url": "http://github.com/kernie66/homebridge-telldus-too/issues"
  },
  "license": "MIT",
  "author": "Kenneth Jagenheim, rewritten from plugin by John Lemón",
  "repository": {
    "type": "git",
    "url": "git://github.com/kernie66/homebridge-telldus-too.git"
  },
  "files": [
    "dist",
    "config.schema.json"
  ],
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "compile": "tsc",
    "contbuild": "vp run compile --watch",
    "devbuild": "vp run --cache compile",
    "watch": "vp run build && vp link && nodemon",
    "test": "vp test run",
    "local-release": "changeset version && changeset publish",
    "release": "changeset publish",
    "prepare": "vp config"
  },
  "dependencies": {
    "@voidzero-dev/vite-plus-test": "^0.1.20",
    "figlet": "^1.11.0",
    "homebridge-config-ui-x": "^5.22.0",
    "homebridge-lib": "^8.1.0",
    "node-cache": "^5.1.2",
    "query-string": "^9.3.1",
    "tsafe": "^1.8.12",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "^4.1.5",
    "@voidzero-dev/vite-plus-core": "^0.1.20",
    "eslint-plugin-unused-imports": "^4.4.1",
    "homebridge": "^2.0.1",
    "msw": "^2.14.5",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.20",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
    "vitest-mock-extended": "^4.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "engines": {
    "homebridge": ">=1.7.0 || ^2.0.0",
    "node": ">=18.16.0"
  },
  "packageManager": "npm@11.12.1"
}
